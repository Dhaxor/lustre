# Lustre — environment template.
# Copy this file to `.env.local` (git-ignored) and paste your real values there.
# NEVER commit real keys. NEVER paste secret keys into chat or share them.
#
# Get these from your Stripe Dashboard (use TEST mode keys first: they start sk_test_ / pk_test_).
# See ../STRIPE_SETUP.md for the exact click-by-click steps.

# --- Stripe (server-side secret — keep private) ---
STRIPE_SECRET_KEY=

# Webhook signing secret from the endpoint you create in the Dashboard (starts whsec_)
STRIPE_WEBHOOK_SECRET=

# --- Stripe (client-side publishable — safe to expose to the browser) ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# When unset, the app runs in DEMO mode with an in-memory FakePaymentService
# (no real charges). Set the keys above to switch on real Stripe escrow + Connect.

# --- Supabase / Postgres (Phase 1 persistence + auth) ---
# See ../SUPABASE_SETUP.md. Get these from your Supabase project (free tier).
# DATABASE_URL = Transaction pooler (port 6543) — used by the app at runtime.
DATABASE_URL=
# DIRECT_URL = Session/Direct connection (port 5432) — used for Prisma migrations.
DIRECT_URL=
# Supabase Auth (project URL + anon key are safe for the browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key is SECRET (server-only) — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Phase-0 admin token guarding /api/connect/onboard and /api/bookings/[id]/complete.
CONNECT_ONBOARD_SECRET=
