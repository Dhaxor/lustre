# Lustre — environment template.
# Copy this file to `.env.local` (git-ignored) and paste your real values there.
# NEVER commit real keys. NEVER paste secret keys into chat or share them.
#
# Get these from your Stripe Dashboard (use TEST mode keys first: they start sk_test_ / pk_test_).
# See ../STRIPE_SETUP.md for the exact click-by-click steps.

# --- Stripe (server-side secret — keep private) ---
STRIPE_SECRET_KEY=

# Webhook signing secret from the endpoint you create in the Dashboard (starts whsec_)
STRIPE_WEBHOOK_SECRET=

# --- Stripe (client-side publishable — safe to expose to the browser) ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# When unset, the app runs in DEMO mode with an in-memory FakePaymentService
# (no real charges). Set the keys above to switch on real Stripe escrow + Connect.
